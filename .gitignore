# --- Dependencies ---
/node_modules
/.pnpm-debug.log*

# --- Next.js Build Output ---
/.next/
/out/
/build/
*.tsbuildinfo
next-env.d.ts

# --- Environment Variables (CRITICAL) ---
# We keep .env.example, but ignore all actual secret files
.env
.env.local
.env.production
.env.development.local
.env.test.local
.env.production.local

# --- Docker & Database ---
# Ignore the actual database storage and local overrides
.docker-compose.override.yml
/postgres_data/
/supabase/.temp/

# --- Context & Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo

# --- Operating System Junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- OneDrive Specific ---
# Prevents OneDrive temporary sync files from entering Git
~$*
.fuse_hidden*

# --- IDE Settings ---
.vscode/
.idea/
*.swp
*.swo